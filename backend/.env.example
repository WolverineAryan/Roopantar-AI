# Roopantar-AI Backend Environment Configuration
# Free Groq API Key (Get free key from https://console.groq.com/keys)
GROQ_API_KEY=
LLM_PROVIDER=groq

# Optional alternative API keys
OPENAI_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Model Selection
LLM_MODEL_FAST=llama-3.3-70b-versatile
LLM_MODEL_STRONG=llama-3.3-70b-versatile
WHISPER_MODEL=whisper-large-v3

# Database & App Settings
DATABASE_URL=sqlite+aiosqlite:///./roopantar.db
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3000
